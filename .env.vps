# --- Database Configuration ---
# Use the INTERNAL docker service name (puja-db) for better security and performance
DATABASE_URL=postgresql://puja_admin:puja_pwd_change_me@puja-db:5432/puja_insights

# --- Application Configuration ---
NODE_ENV=production
PORT=5000

# --- User Identity (Optional but Recommended) ---
SESSION_SECRET=puja_session_secret_12345
SECRET_KEY=puja_secret_key_12345

# --- Domain & SEO (Used for sitemap and absolute links) ---
BASE_URL=https://radheradhepuja.com
PUBLIC_FRONTEND_URL=https://radheradhepuja.com
