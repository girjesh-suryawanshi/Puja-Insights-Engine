# Database Configuration
# Replace 'username', 'password', 'localhost', and 'puja_insights' with your local Postgres 18 credentials.
DATABASE_URL="postgresql://postgres:deergh@localhost:5432/puja_insights?schema=public"

# API Server Configuration
PORT=5000
NODE_ENV=development

# Frontend (Vite) Configuration
# The port the dev server will run on
VITE_PORT=3000
# Base path for the app (usually /)
BASE_PATH="/"
# The API URL the frontend will connect to
VITE_API_URL="http://localhost:5000/api"
